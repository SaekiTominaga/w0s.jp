---
import Layout from '@layouts/Madoka.astro';
import Anchor from '@components/+phrasing/Anchor.astro';
import Table from '@components/Table.astro';
import type { StructuredData } from '../../../../@types/util.d.ts';

const structuredData: StructuredData = {
	title: '蒼樹うめ展',
	description: '2015年〜2018年に行われた「蒼樹うめ展」の開催情報をまとめました。',
	breadcrumb: [{ path: '/madoka/', name: 'まどか資料館' }],
};
---

<Layout astroFilePath={Astro.self.moduleId} structuredData={structuredData}>
	<Table>
		<thead>
			<tr>
				<th scope="col">地域</th>
				<th scope="col" aria-sort="ascending">期間</th>
				<th scope="col">場所</th>
				<th scope="col">備考</th>
			</tr>
		</thead>
		<tbody>
			<tr>
				<th scope="row">東京</th>
				<td>2015年10月3日(土)〜12日(月・祝)</td>
				<td>上野の森美術館</td>
				<td>サイン会: 10月4日(日)、9日(金) 15時〜</td>
			</tr>
			<tr>
				<th scope="row">大阪</th>
				<td>2016年3月19日(土)〜27日(日)</td>
				<td>大阪文化館・天保山</td>
				<td>サイン会: 3月20日(日) 15時〜</td>
			</tr>
			<tr>
				<th scope="row">新潟</th>
				<td>
					前期: 2017年2月18日(土)〜3月20日(日)<br />後期: 2017年3月25日(土)〜4月23日(日)
				</td>
				<td>新潟市マンガ・アニメ情報館</td>
				<td>サイン会: 3月4日(土)、4月8日(土) 13時〜</td>
			</tr>
			<tr>
				<th scope="row">青森</th>
				<td>2017年12月16日(土)〜2018年2月12日(月・祝)</td>
				<td>青森県立美術館 企画展示室</td>
				<td>サイン会: 12月16日(土)、1月27日(土) 14時〜</td>
			</tr>
		</tbody>
	</Table>
</Layout>

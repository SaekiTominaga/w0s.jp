---
import Layout from '@layouts/Madoka.astro';
import Anchor from '@components/+phrasing/Anchor.astro';
import Table from '@components/Table.astro';
import type { StructuredData } from '../../../../@types/util.d.ts';

const structuredData: StructuredData = {
	title: 'MADOGATARI 展',
	description: '2015年〜2016年に行われた「MADOGATARI 展」の開催情報をまとめました。',
	breadcrumb: [{ path: '/madoka/', name: 'まどか資料館' }],
};
---

<Layout astroFilePath={Astro.self.moduleId} structuredData={structuredData}>
	<Table>
		<thead>
			<tr>
				<th scope="col">地域</th>
				<th scope="col" aria-sort="ascending">期間</th>
				<th scope="col">場所</th>
				<th scope="col">備考</th>
				<th scope="col">紹介サイト</th>
			</tr>
		</thead>
		<tbody>
			<tr>
				<th scope="row">東京</th>
				<td>2015年11月27日(金)〜12月2日(水)</td>
				<td>3331 Arts Chiyoda</td>
				<td>11月29日、ベルサール秋葉原でキャストトークステージ</td>
				<td><Anchor href="http://www.madogatari.jp/tokyo/" icon={false}>公式ページ</Anchor>、<Anchor href="https://web.archive.org/web/20150808023818/https://www.shaft-web.co.jp/madogatari.html" icon={false}>SHAFT</Anchor>、アニメイトタイムズ（<Anchor href="https://www.animatetimes.com/news/details.php?id=1448627089" icon={false}>内覧会</Anchor>、<Anchor href="https://www.animatetimes.com/news/details.php?id=1449147045" icon={false}>終了後報告</Anchor>、<Anchor href="https://www.animatetimes.com/news/details.php?id=1449234188" icon={false}>コンセプトムービー</Anchor>）、<Anchor href="https://web.archive.org/web/20151128045558/https://kai-you.net/article/23633" icon={false}>KAI-YOU.net</Anchor>、<Anchor href="https://web.archive.org/web/20151130102444/https://blog.2ji-iro.jp/archives/58053" icon={false}>なな情報局</Anchor>、<Anchor href="https://web.archive.org/web/20230209062015/http://gs.dengeki.com/news/53219/" icon={false}>電撃G's magazine.com</Anchor></td>
			</tr>
			<tr>
				<th scope="row">大阪</th>
				<td>2015年12月22日(火)〜27日(日)</td>
				<td>ハービスホール</td>
				<td>来場者特典: クリスマスカード（12月24日、25日のみ）</td>
				<td><Anchor href="http://www.madogatari.jp/osaka/" icon={false}>公式ページ</Anchor>、<Anchor href="https://gigazine.net/news/20151222-madogatari-exhibition-osaka/" icon={false}>GIGAZINE</Anchor>、<Anchor href="https://news.mynavi.jp/article/20151222-a703/" icon={false}>マイナビニュース</Anchor>、<Anchor href="https://www.animatetimes.com/news/details.php?id=1450790952" icon={false}>アニメイトタイムズ</Anchor></td>
			</tr>
			<tr>
				<th scope="row">札幌</th>
				<td>2016年2月9日(火)〜14日(日)</td>
				<td>サッポロファクトリーホール</td>
				<td>来場者特典: バレンタインカード、クリアファイル</td>
				<td><Anchor href="http://www.madogatari.jp/sapporo/" icon={false}>公式ページ</Anchor>、<Anchor href="https://web.archive.org/web/20160206022358/http://www.hochi.co.jp/entertainment/20160205-OHT1T50080.html" icon={false}>スポーツ報知（雪像）</Anchor>、<Anchor href="https://news.mynavi.jp/article/20160210-a084/" icon={false}>マイナビニュース</Anchor></td>
			</tr>
			<tr>
				<th scope="row">名古屋</th>
				<td>2016年5月4日(水・祝)〜8日(日)</td>
				<td>名古屋市中小企業振興会館・第1ファッション展示場</td>
				<td>ヒロイン総選挙、MADOGATARIくじ、来場者特典: アニバーサリーカード</td>
				<td><Anchor href="http://www.madogatari.jp/nagoya/" icon={false}>公式ページ</Anchor>、<Anchor href="https://news.mynavi.jp/article/20160219-a591/" icon={false}>マイナビニュース</Anchor>、<Anchor href="https://www.animatetimes.com/news/details.php?id=1455884249" icon={false}>アニメイトタイムズ</Anchor></td>
			</tr>
			<tr>
				<th scope="row">東京アンコール</th>
				<td>2016年9月22日(木・祝)〜25日(日)</td>
				<td>TEPIA イベントホール</td>
				<td>名台詞投票、来場者特典: アニバーサリーイラスト（蒼樹うめ／VOFAN）、COSSAN meets MADOGATARI展（25日のみ）</td>
				<td><Anchor href="http://www.madogatari.jp/tokyo_encore/" icon={false}>公式ページ</Anchor>、PR TIMES（<Anchor href="https://prtimes.jp/main/html/rd/p/000000142.000016356.html" icon={false}>No.1ヒロインイラスト</Anchor>、<Anchor href="https://prtimes.jp/main/html/rd/p/000000150.000016356.html" icon={false}>日程</Anchor>、<Anchor href="https://prtimes.jp/main/html/rd/p/000000154.000016356.html" icon={false}>メインビジュアル</Anchor>、<Anchor href="https://prtimes.jp/main/html/rd/p/000000205.000016356.html" icon={false}>クビキリサイクル</Anchor>、<Anchor href="https://prtimes.jp/main/html/rd/p/000000210.000016356.html" icon={false}>来場企画</Anchor>）</td>
			</tr>
			<tr>
				<th scope="row">金沢（GALLERY）</th>
				<td>2016年12月22日(木)〜25日(日)</td>
				<td>金沢21世紀美術館</td>
				<td></td>
				<td><Anchor href="http://www.madogatari.jp/madogatari_gallery/" icon={false}>公式ページ</Anchor>、<Anchor href="https://prtimes.jp/main/html/rd/p/000000210.000016356.html" icon={false}>PR TIMES</Anchor></td>
			</tr>
		</tbody>
	</Table>
</Layout>

---
import SearchCtrl from '@components/SearchCtrl.astro';
---

<search role="search" aria-label="サイト">
	<form action="/search" class="search-form">
		<fieldset>
			<legend class="legend">サイト内検索</legend>
			<div class="ctrl">
				<SearchCtrl />
			</div>
		</fieldset>
	</form>
</search>

<style>
	@layer component {
		.search-form {
			display: block grid;
			grid-template-areas:
				'legend'
				'ctrl';
			gap: 0.25em;
			line-height: var(--line-height-narrow);

			& > :global(fieldset) {
				display: contents;
			}
		}

		.legend {
			grid-area: legend;
			font-size: calc(100% / pow(var(--font-ratio), 1));
		}

		.ctrl {
			grid-area: ctrl;
		}
	}
</style>

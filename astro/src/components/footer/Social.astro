---
import Anchor from '@components/+phrasing/Anchor.astro';

interface Props {
	pagePath: string;
}

const { pagePath } = Astro.props;
---

<ul class="social">
	<li>
		<Anchor href="https://github.com/SaekiTominaga/w0s.jp" icon={false}>
			<span class="icon"><img src="/assets/image/icon/github.svg" alt="" width="48" height="48" /></span>
			<span class="title">GitHub</span>
		</Anchor>
	</li>
	{
		!pagePath.substring(1).includes('/') && (
			<li>
				<Anchor href="https://fedibird.com/@SaekiTominaga" icon={false}>
					<span class="icon">
						<img src="/assets/image/icon/mastodon.svg" alt="" width="48" height="48" />
					</span>
					<span class="title">Mastodon</span>
				</Anchor>
			</li>
		)
	}
	<li>
		<Anchor href="https://bsky.app/profile/w0s.jp" icon={false}>
			<span class="icon"><img src="/assets/image/icon/bluesky.svg" alt="" width="48" height="48" /></span>
			<span class="title">Bluesky</span>
		</Anchor>
	</li>
	<li>
		<Anchor href="https://www.youtube.com/@SaekiTominaga" icon={false}>
			<span class="icon"><img src="/assets/image/icon/youtube.svg" alt="" width="48" height="48" /></span>
			<span class="title">YouTube</span>
		</Anchor>
	</li>
</ul>

<style>
	@layer component {
		.social {
			display: block flex;
			flex-direction: row;
			flex-wrap: wrap;
			gap: 24px;
			font-size: calc(100% / pow(var(--font-ratio), 2));

			@container footer-social (inline-size >= 600px) {
				justify-content: flex-end;
			}

			& :global(:any-link) {
				display: block grid;
				justify-items: center;
				outline-offset: 0.5em;
				max-inline-size: 72px;
				pointer-events: none;
			}

			& :global(:any-link > *) {
				pointer-events: auto;
			}
		}

		.icon {
			padding-block-end: 0.5em;
		}

		.title {
			word-break: auto-phrase;
		}
	}
</style>

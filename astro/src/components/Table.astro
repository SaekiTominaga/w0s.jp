---
import { parse } from 'node-html-parser';

interface Props {
	id?: string;
	full?: boolean;
	scroll?: boolean;
	font?: 'small';
}

const { id, full, scroll, font } = Astro.props;

const $root = parse(await Astro.slots.render('default'));
const $caption = $root.querySelector('caption');
const $thead = $root.querySelector('thead');
const $$tbody = $root.querySelectorAll('tbody');
const $tfoot = $root.querySelector('tfoot');
---

<div id={id} class:list={['table-wrapper', { '-full': full }, { '-scroll': scroll }, { '-font-small': font === 'small' }]}>
	<table class="js-thead-sticky-table">
		{
			$caption !== null && (
				<caption>
					<div class="caption-inner">
						<Fragment set:html={$caption?.innerHTML} />
					</div>
				</caption>
			)
		}
		<Fragment set:html={$thead} />
		<Fragment set:html={$$tbody} />
		<Fragment set:html={$tfoot} />
	</table>
</div>

<style>
	@layer component {
		.table-wrapper {
			--stickey-thead-block-size: 1em;
			--_border-color: var(--border-color-dark);
			--_bg-color: var(--color-white);
			--_color: var(--color-black);
			--_font-size-base: 100%;

			@media print {
				--_border-color: var(--color-black);
			}

			/* 全幅 */
			&.-full {
				inline-size: 100%;
			}

			/* 横スクロール */
			&.-scroll {
				@media not print {
					--_text-wrap-mode: nowrap;

					padding-block-end: 2px; /* 横スクロールバー上部の空き */
					overflow-x: auto;
				}
			}

			/* 文字サイズを小さくする */
			&.-font-small {
				--_font-size-base: calc(100% / pow(var(--font-ratio), 2));
			}

			& > :global(table) {
				line-height: var(--line-height-narrow);
			}

			& > :global(table > caption) {
				margin-block-end: 0.25em;
				font-weight: var(--font-weight-bold);
			}

			&:not(.-scroll) {
				& .caption-inner {
					margin-inline: auto;
					inline-size: fit-content;
				}
			}

			& > :global(table > thead) {
				--_bg-color: var(--bgcolor-dark);
				--_text-align: center;

				position: sticky;
				inset-block-start: 0;
				z-index: 1;
			}

			& > :global(table > tbody) {
				--_text-align: start;
			}

			& > :global(table > tfoot) {
				--_bg-color: var(--bgcolor-dark);
				--_text-align: start;
			}

			& > :global(table > :is(thead + tbody, tbody + tbody, tfoot)) {
				border-block-start: 2px solid var(--_border-color);
			}

			& > :global(table :is(td, th)) {
				border: 1px solid var(--_border-color);
				background-clip: padding-box; /* for Firefox, Safari (<thead> sticky) */
				background-color: var(--_bg-color);
				padding-block: 0.75em;
				padding-inline: min(1dvi, 10px);
				text-align: var(--_text-align);
				text-wrap-mode: var(--_text-wrap-mode);
				color: var(--color-black);
				font-size: clamp(calc(var(--_font-size-base) / pow(var(--font-ratio), 1)), 2svi, var(--_font-size-base));
			}

			& > :global(table > tbody th) {
				--_bg-color: var(--bgcolor-light);
			}

			& > :global(table > :is(tbody, tfoot) :target) {
				scroll-margin-block-start: var(--stickey-thead-block-size);
			}
		}
	}
</style>

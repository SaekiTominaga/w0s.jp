---
import Anchor from '@components/+phrasing/Anchor.astro';

interface Props {
	title: string;
	link: string;
	icon: string;
}

const { title, link, icon } = Astro.props;
---

<li>
	<Anchor href={link} icon={false}>
		<span class="icon"><img src={icon} alt="" width="64" height="64" /></span>
		<span class="text"><span class="title">{title}</span></span>
	</Anchor>
</li>

<style>
	@layer component {
		li {
			& > :global(:any-link) {
				display: block grid;
				justify-items: center;
				outline-offset: 0.5em;
				pointer-events: none;
			}
		}

		.icon {
			padding-block-end: 0.5em;
			pointer-events: auto;
		}

		.text {
		}

		.title {
			word-break: auto-phrase;
			pointer-events: auto;
		}
	}
</style>

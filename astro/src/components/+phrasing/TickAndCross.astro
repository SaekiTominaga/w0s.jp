---
interface Props {
	type: 'tick' | 'cross';
}

const { type } = Astro.props;
---

<span class:list={['tac', `-${type}`]}>
	<span class="text"><slot /></span>
</span>

<style>
	@layer component {
		.tac {
			display: inline grid;
			grid-template-columns: minmax(1ic, auto) auto;
			gap: 0.25em;

			&::before {
				justify-self: center;
				text-shadow:
					0.5px 0.5px,
					0.5px -0.5px,
					-0.5px 0.5px,
					-0.5px -0.5px;
				color: var(--_color, inherit);
				content: var(--_symbol, none);
			}

			/* 肯定 */
			&.-tick {
				--_symbol: '✓';
				--_color: var(--color-green);
			}

			/* 否定 */
			&.-cross {
				--_symbol: '✗';
				--_color: var(--color-red-text);
			}
		}
	}
</style>

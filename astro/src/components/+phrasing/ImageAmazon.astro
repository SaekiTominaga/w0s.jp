---
import PaapiItemImageUrlParser from '@w0s/paapi-item-image-url-parser';

interface Props {
	src: string;
	alt?: string;
	width: number;
	height: number;
	fetchPriority?: 'high' | 'low' | 'auto';
	class?: string;
}

const { src, alt = '', width, height, fetchPriority, class: className } = Astro.props;

const paapiItemImageUrlParser = new PaapiItemImageUrlParser(new URL(src));
paapiItemImageUrlParser.setSizeMultiply(2);
const imageUrl2x = paapiItemImageUrlParser.toString();
---

<img src={src} srcset={`${imageUrl2x} 2x`} alt={alt} width={width} height={height} fetchpriority={fetchPriority} class:list={className} />

---
interface Props {
	id: string;
}

const { id } = Astro.props;
---

<p><output class="invalid" id={id}></output></p>

<style>
	@layer component {
		.invalid {
			color: var(--color-red-text);
			font-size: calc(100% / pow(var(--font-ratio), 1));

			&:not(:empty) {
				&::before {
					margin-inline-end: 0.25em;
					content: '⚠';
				}
			}
		}
	}
</style>

---
import IsbnVerify from '@w0s/isbn-verify';
import { dateDisplay } from '@util/date.ts';
import EmbeddedLink from './EmbeddedLink.astro';
import EmbeddedSidebar from './EmbeddedSidebar.astro';
import Anchor from './+phrasing/Anchor.astro';
import ImageAmazon from './+phrasing/ImageAmazon.astro';
import SelfLink from './+phrasing/SelfLink.astro';

interface Props {
	id: string;
	headingLevel: number;
	title: string;
	release?: string;
	distribution?: string;
	tags?: string[];
	isbn?: string;
	amazonAsin?: string;
	amazonImageId?: string;
	amazonImageWidth?: number;
	amazonImageHeight?: number;
}

const { id, headingLevel, title, release, distribution, tags, isbn, amazonAsin, amazonImageId, amazonImageWidth, amazonImageHeight } = Astro.props;

if (isbn !== undefined && !new IsbnVerify(isbn, { strict: true }).isValid()) {
	throw new Error(`Invalid ISBN: \`${isbn}\``);
}
---

<section class="library js-library" id={id}>
	<header class="header">
		{headingLevel === 3 && <h3 class="hdg">{title}</h3>}
		<p class="self-link"><SelfLink id={id} /></p>
		{
			release !== undefined && (
				<p class="release">
					<time datetime={release}>{dateDisplay(release)}</time>発売
				</p>
			)
		}
		{
			distribution !== undefined && (
				<p class="release">
					<time datetime={distribution}>{dateDisplay(distribution)}</time>配布
				</p>
			)
		}
		{
			tags !== undefined && tags.length >= 1 && (
				<div class="tags">
					{tags.map((tag) => (
						<button type="button" class="tag-button js-library-tag" disabled="">
							{tag}
						</button>
					))}
				</div>
			)
		}
		{
			isbn !== undefined && (
				<p class="isbn">
					{/* prettier-ignore */}
					<span class="isbn-link">ISBN: <Anchor href={`https://ndlsearch.ndl.go.jp/search?cs=bib&f-isbn=${isbn}`}><data value={isbn}>{isbn}</data></Anchor></span>
				</p>
			)
		}
	</header>
	<div class="main">
		{amazonAsin === undefined && <slot />}
		{
			amazonAsin !== undefined && (
				<EmbeddedSidebar>
					<EmbeddedLink href={`https://www.amazon.co.jp/dp/${amazonAsin}/ref=nosim?tag=w0s.jp-22`} title="Amazon 商品ページ" slot="embedded">
						<Fragment slot="media">
							{amazonImageId !== undefined && amazonImageWidth !== undefined && amazonImageHeight !== undefined && <ImageAmazon src={`https://m.media-amazon.com/images/I/${amazonImageId}._SL160_.jpg`} alt="表紙" width={amazonImageWidth} height={amazonImageHeight} />}
							{(amazonImageId === undefined || amazonImageWidth === undefined || amazonImageHeight === undefined) && <img src="/assets/image/amazon-noimage.svg" alt="表紙画像なし" width="113" height="160" />}
						</Fragment>
					</EmbeddedLink>

					<slot slot="text" />
				</EmbeddedSidebar>
			)
		}
	</div>
</section>

<style>
	@layer component {
		.library {
			--_border-width: 1px;
			--_border-radius-inner: calc(var(--border-radius-normal) - var(--_border-width));
			--_padding-inline: clamp(8px, 1.5dvi, 16px);

			border: var(--_border-width) solid var(--border-color-dark);
			border-radius: var(--border-radius-normal);
			background-color: var(--color-white);
			line-height: var(--line-height-normal);
			color: var(--color-black);
		}

		.header {
			--_header-padding-block: 12px;

			display: block flex;
			flex-wrap: wrap;
			gap: 0.5em;
			align-items: center;
			contain: layout;
			border-start-start-radius: var(--_border-radius-inner);
			border-start-end-radius: var(--_border-radius-inner);
			background-color: oklch(from var(--color-green) 100% calc(c - 0.1) h);
			padding-block: var(--_header-padding-block);
			padding-inline: calc(var(--_padding-inline) + var(--self-link-size)) var(--_padding-inline);
		}

		.main {
			padding-block: 24px;
			padding-inline: var(--_padding-inline);

			& > :global(* + *) {
				margin-block-start: var(--stack-margin-base);
			}
		}

		.hdg {
			font-size: calc(100% * pow(var(--font-ratio), 2));
		}

		.self-link {
			position: absolute;
			inset-block-start: calc(var(--_header-padding-block) + 0.25ex);
			inset-inline-start: calc(var(--_padding-inline) - 0.25em);
		}

		.release {
			display: inline flex;
			flex-wrap: wrap;

			&::before {
				content: '（';
			}

			&::after {
				content: '）';
			}
		}

		.tags {
			display: block flex;
			flex-wrap: wrap;
			gap: 0.5em;
			margin-inline-start: 0.5em;
		}

		.tag-button {
			display: inline flex;
			flex-wrap: nowrap;
			gap: 0.5em;
			align-items: center;
			border: 1px solid var(--color-black);
			border-radius: var(--border-radius-large);
			background-color: var(--color-white);
			padding-block: 0.25em;
			padding-inline: 0.5em;
			line-height: var(--line-height-nowrap);
			color: var(--color-black);
			font-size: calc(100% / pow(var(--font-ratio), 1));

			&:disabled {
				background-color: var(--bgcolor-dark);
			}

			&:focus-visible {
				outline-offset: -1px;
				outline-width: var(--outline-width-bold);
			}

			&:focus:not(:focus-visible) {
				outline: none;
			}

			&::after {
				background-image: url('data:image/svg+xml;charset=utf-8,%3Csvg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"%3E%3Cpath d="M11,20q-0.42,0-0.71-0.29Q10,19.43 10,19V13L4.2,5.6Q3.83,5.1 4.09,4.55T5,4H19q0.65,0 0.91,0.55T19.8,5.6L14,13v6q0,0.43-0.29,0.71T13,20H11Zm1-7.7L16.95,6H7.05L12,12.3Zm0,0Z"/%3E%3C/svg%3E'); /* https://fonts.google.com/icons : Filter Alt */
				background-position: top center;
				background-repeat: no-repeat;
				background-size: 1rem;
				padding-block-start: 1rem;
				font-size: calc(100% / pow(var(--font-ratio), 4));
				content: '絞込';
			}

			&[aria-pressed='false' i] {
				&:hover {
					background-color: oklch(from var(--color-white) calc(l - var(--bgcolor-hover-l)) c h);
				}
			}

			&[aria-pressed='true' i] {
				background-color: oklch(from var(--color-pink) calc(l + 0.1) c h);

				&:hover {
					background-color: oklch(from var(--color-pink) calc(l + 0.1 - var(--bgcolor-hover-l)) c h);
				}

				&::after {
					background-image: url('data:image/svg+xml;charset=utf-8,%3Csvg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"%3E%3Cpath d="M14.8,11.98l-1.43-1.43L16.95,6H8.83l-2-2H19q0.63,0 0.9,0.55T19.8,5.6l-5,6.38ZM19.78,22.6L14,16.83V19q0,0.43-0.29,0.71T13,20H11q-0.42,0-0.71-0.29Q10,19.43 10,19V12.83L1.4,4.22L2.8,2.8L21.2,21.2l-1.43,1.4Zm-6.4-12.05Z"/%3E%3C/svg%3E'); /* https://fonts.google.com/icons : Filter Alt Off */
					content: '絞込解除';
				}
			}
		}

		.isbn {
			display: inline grid;
			flex-basis: 100%;
			justify-items: end;
		}

		.isbn-link {
		}
	}
</style>

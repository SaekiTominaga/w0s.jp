---
import { getHTMLId } from '@util/crypto.ts';

const buttonTitleId = getHTMLId();
---

<div class="search">
	<select name="engine" title="検索エンジン" class="engine">
		<option value="google">Google</option>
		<option value="bing">Bing</option>
		<option value="yahoo">Yahoo! JAPAN</option>
		<option value="ddg">DuckDuckGo</option>
	</select>
	<input type="search" name="q" required="" title="キーワード" class="query" />
	<button class="submit">
		<svg role="img" aria-labelledby={buttonTitleId}>
			<title id={buttonTitleId}>検索</title>
			<use href="/assets/image/icon/search.svg#icon"></use>
		</svg>
	</button>
</div>

<style>
	@layer component {
		.search {
			display: block flex;
			flex-wrap: wrap;
			border: 1px solid var(--border-color-dark);
			border-radius: var(--border-radius-small);
			background-color: var(--color-white);
			line-height: var(--line-height-narrow);
			color: var(--color-darkgray);

			& :is(input, select, button) {
				line-height: inherit;
			}
		}

		/* 検索エンジン選択欄 */
		.engine {
			display: inline flex;
			flex-wrap: nowrap;
			align-items: center;
			outline-offset: -1px;
			border-block-style: unset;
			border-inline-start-style: unset;
			border-inline-end: 1px solid var(--border-color-dark);
			border-radius: var(--border-radius-small) 0 0 var(--border-radius-small);
			background-color: var(--color-white);
			padding: 0 0.5em;
			font-family: Arial, sans-serif;
			font-size: calc(100% / pow(var(--font-ratio), 4));
			font-stretch: condensed;
			field-sizing: content;

			& > :global(option) {
				font-size: calc(100% * pow(var(--font-ratio), 4));
			}

			&:focus {
				outline-width: var(--outline-width-bold);
			}

			&:hover {
				background-color: oklch(from var(--color-white) calc(l - var(--bgcolor-hover-l)) c h);
			}
		}

		/* キーワード入力欄 */
		.query {
			all: unset;
			display: block flow;
			flex-basis: 0;
			flex-grow: 1;
			outline-offset: -1px;
			padding: 0.25em;
			inline-size: 100%;

			&:focus {
				outline: var(--outline-width-bold) solid var(--outline-color);
			}

			&:hover {
				background-color: oklch(from var(--color-white) calc(l - var(--bgcolor-hover-l)) c h);
			}
		}

		/* 送信ボタン */
		.submit {
			all: unset;
			outline-offset: -1px;
			border-radius: 0 var(--border-radius-small) var(--border-radius-small) 0;
			padding: 0.375em;
			block-size: 1.5em;
			inline-size: 1.5em;
			color: oklch(from var(--color-blue) l calc(c - 0.15) h);
			fill: currentColor; /* SVG */

			&:focus-visible {
				outline: var(--outline-width-bold) solid var(--outline-color);
			}

			&:hover {
				background-color: oklch(from var(--color-white) calc(l - var(--bgcolor-hover-l)) c h);
			}

			& > :global(svg) {
				block-size: 100%;
				inline-size: 100%;
			}
		}
	}
</style>

---
import { getHTMLId } from '@util/crypto.ts';

const buttonTitleId = getHTMLId();
---

<div class="search">
	<select name="engine" title="検索エンジン" class="engine js-search-engine" data-storage-key="search-engine">
		<button is:raw><selectedcontent></selectedcontent></button>
		<option value="google">
			<span class="content"><img src="/assets/image/icon/google.png" alt="" width="16" height="16" /><span class="content-text">Google</span></span>
		</option>
		<option value="bing">
			<span class="content"><img src="/assets/image/icon/bing.png" alt="" width="16" height="16" /><span class="content-text">Bing</span></span>
		</option>
		<option value="yahoo">
			<span class="content"><img src="/assets/image/icon/yahoo.png" alt="" width="16" height="16" /><span class="content-text">Yahoo! JAPAN</span></span>
		</option>
		<option value="ddg">
			<span class="content"><img src="/assets/image/icon/duckduckgo.svg" alt="" width="16" height="16" /><span class="content-text">DuckDuckGo</span></span>
		</option>
	</select>
	<input type="search" name="q" required="" title="キーワード" class="query" />
	<button class="submit">
		<svg role="img" aria-labelledby={buttonTitleId}>
			<title id={buttonTitleId}>検索</title>
			<use href="/assets/image/icon/search.svg#icon"></use>
		</svg>
	</button>
</div>

<style>
	@layer component {
		.search {
			--_animation-duration: 0.1s;

			display: block flex;
			flex-wrap: wrap;
			border: 1px solid var(--border-color-dark);
			border-radius: var(--border-radius-small);
			background-color: var(--color-white);
			line-height: var(--line-height-narrow);
			color: var(--color-darkgray);

			& :is(input, select, button) {
				line-height: inherit;
			}

			& :focus {
				z-index: 0;
			}
		}

		/* 検索エンジン選択欄 */
		.engine {
			display: inline flex;
			flex-wrap: nowrap;
			align-items: center;
			transition-duration: var(--_animation-duration);
			transition-property: background-color;
			outline-offset: -1px;
			border-block-style: unset;
			border-inline-start-style: unset;
			border-inline-end: 1px solid var(--border-color-dark);
			border-radius: var(--border-radius-small) 0 0 var(--border-radius-small);
			background-color: var(--color-white);
			padding: 0 0.5em;

			/* Customizable Select 未対応環境向け */
			@supports not (appearance: base-select) {
				font-family: Arial, sans-serif;
				font-size: calc(100% / pow(var(--font-ratio), 4));
				font-stretch: condensed;
				field-sizing: content;

				& > :global(option) {
					font-size: calc(100% * pow(var(--font-ratio), 4));
				}
			}

			&:focus {
				outline-width: var(--outline-width-bold);
			}

			&:hover {
				background-color: oklch(from var(--color-white) calc(l - var(--bgcolor-hover-l)) c h);
			}

			&,
			&::picker(select) {
				appearance: base-select;
			}

			&::picker(select) {
				border-color: var(--border-color-dark);
			}

			& :global(selectedcontent) {
				display: contents;
			}

			& > :global(option) {
				outline-offset: calc(0px - var(--outline-width-bold));
				padding: 0.5em;
				min-block-size: unset;
			}

			& > :global(option:focus-visible) {
				outline-width: var(--outline-width-bold);
			}

			& > :global(option:focus:not(:focus-visible)) {
				outline: none;
			}

			& > :global(option:enabled:hover) {
				background-color: oklch(from var(--color-white) calc(l - var(--bgcolor-hover-l)) c h);
			}

			& > :global(option::checkmark) {
				font-weight: 900;
			}
		}

		.content {
			display: inline flex;
			flex-wrap: nowrap;
			column-gap: 0.5em;
			align-items: center;

			:global(selectedcontent) & {
				flex-direction: column;
				line-height: var(--line-height-nowrap);
			}

			& :global(img) {
				block-size: 1em;
				inline-size: 1em;
				vertical-align: middle;
			}
		}

		.content-text {
			:global(selectedcontent) & {
				text-wrap-mode: nowrap;
				font-size: calc(100% / pow(var(--font-ratio), 4));

				@media (prefers-reduced-motion: no-preference) {
					transition-duration: var(--_animation-duration);
					transition-behavior: allow-discrete;
					interpolate-size: allow-keywords;
				}
			}

			.search:has(.query:focus) & {
				block-size: 0;
				inline-size: 0;
				overflow: hidden;
				font-size: 0;
			}
		}

		/* キーワード入力欄 */
		.query {
			all: unset;
			display: block flow;
			flex-basis: 0;
			flex-grow: 1;
			transition-duration: var(--_animation-duration);
			transition-property: background-color;
			outline-offset: -1px;
			padding: 0.25em;
			inline-size: 100%;

			&:focus {
				outline: var(--outline-width-bold) solid var(--outline-color);
			}

			&:hover {
				background-color: oklch(from var(--color-white) calc(l - var(--bgcolor-hover-l)) c h);
			}
		}

		/* 送信ボタン */
		.submit {
			all: unset;
			transition-duration: var(--_animation-duration);
			transition-property: background-color;
			outline-offset: -1px;
			border-radius: 0 var(--border-radius-small) var(--border-radius-small) 0;
			padding: 0.375em;
			block-size: 1.5em;
			inline-size: 1.5em;
			color: oklch(from var(--color-blue) l calc(c - 0.15) h);
			fill: currentColor; /* SVG */

			&:focus-visible {
				outline: var(--outline-width-bold) solid var(--outline-color);
			}

			&:hover {
				background-color: oklch(from var(--color-white) calc(l - var(--bgcolor-hover-l)) c h);
			}

			& > :global(svg) {
				block-size: 100%;
				inline-size: 100%;
			}
		}
	}
</style>

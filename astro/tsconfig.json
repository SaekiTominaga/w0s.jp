{
	"extends": "astro/tsconfigs/strictest",
	"include": [".astro/types.d.ts", "src/**/*.astro", "src/**/*.ts"],
	"exclude": ["dist"],
	"compilerOptions": {
		/* Modules */
		"paths": {
			"@api/*": ["./src/pages/api/*"],
			"@components/*": ["./src/components/*"],
			"@layouts/*": ["./src/layouts/*"],
			"@config/*": ["./src/+config/*"],
			"@db/*": ["./src/+db/*"],
			"@image/*": ["./src/+image/*"],
			"@util/*": ["./src/+util/*"]
		}
	}
}

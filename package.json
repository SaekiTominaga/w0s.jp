{
	"name": "w0s.jp",
	"private": true,
	"type": "module",
	"scripts": {
		"lint": "pnpm run /^lint:.*/",
		"lint:css": "stylelint -f verbose astro/src/**/*.astro astro/dist/client/assets/astro/*.css frontend/css",
		"lint:js": "pnpm -F astro exec astro sync && oxlint",
		"lint:html": "markuplint astro/src/**/*.astro",
		"lint-dist:html": "markuplint astro/dist/client/**/*.html"
	},
	"dependencies": {
		"kysely": "^0.29.5",
		"prettier": "3.9.6"
	},
	"devDependencies": {
		"@markuplint/astro-parser": "4.18.0",
		"@types/node": "24.13.2",
		"@w0s/markuplint-config": "3.13.0",
		"@w0s/oxlint-config": "^1.0.7",
		"@w0s/stylelint-config": "4.24.0",
		"@w0s/tsconfig": "3.0.0",
		"brotli-cli": "2.1.1",
		"eslint-plugin-playwright": "^2.11.0",
		"oxlint": "^1.80.0",
		"oxlint-plugin-safely-storage": "^1.0.0",
		"oxlint-tsgolint": "^7.0.2001",
		"postcss": "^8.5.15",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-ejs": "1.0.3",
		"rimraf": "6.1.3",
		"stylelint": "17.14.0",
		"stylelint-attribute-case-sensitivity": "3.1.0",
		"stylelint-config-concentric-order": "5.5.0",
		"stylelint-config-standard": "40.0.0",
		"stylelint-no-default-viewport": "2.0.1",
		"stylelint-plugin-defensive-css": "2.9.3",
		"stylelint-root-colors": "3.0.1",
		"typescript": "6.0.3"
	},
	"packageManager": "pnpm@11.8.0"
}

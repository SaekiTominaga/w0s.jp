{
	"name": "w0s.jp",
	"private": true,
	"type": "module",
	"scripts": {
		"lint": "pnpm run /^lint:.*/",
		"lint:css": "stylelint -f verbose \"astro/src/**/*.astro\" \"astro/dist/client/assets/astro/*.css\" \"frontend/css\"",
		"lint:js": "pnpm -F astro exec astro sync && oxlint",
		"lint:html": "markuplint \"astro/src/**/*.astro\"",
		"lint-dist:html": "markuplint \"astro/dist/client/**/*.html\""
	},
	"dependencies": {
		"kysely": "=0.29.9",
		"prettier": "=3.10.1"
	},
	"devDependencies": {
		"@markuplint/astro-parser": "=5.6.1",
		"@types/node": "=26.6.6",
		"@w0s/markuplint-config": "=4.0.4",
		"@w0s/oxlint-config": "=1.0.9",
		"@w0s/stylelint-config": "=5.0.1",
		"@w0s/tsconfig": "=3.2.2",
		"brotli-cli": "=2.1.1",
		"eslint-plugin-playwright": "=2.12.2",
		"markuplint": "=5.6.1",
		"oxlint": "=1.94.0",
		"oxlint-plugin-safely-storage": "=1.0.2",
		"oxlint-tsgolint": "=7.0.2007",
		"postcss": "=8.5.33",
		"prettier-plugin-astro": "=0.14.1",
		"prettier-plugin-ejs": "=1.0.3",
		"rimraf": "=6.1.4",
		"stylelint": "=18.0.0",
		"typescript": "=6.0.3"
	},
	"packageManager": "pnpm@12.16.1"
}

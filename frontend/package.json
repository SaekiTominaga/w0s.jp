{
	"name": "frontend",
	"private": true,
	"type": "module",
	"scripts": {
		"predev": "rimraf -g \".dist/**/*.br\"",
		"dev": "pnpm run /^dev:.*/",
		"dev:static": "node build/src/static.ts -s static -d .dist --svgoConfig svgo.config.js -w",
		"dev:css": "postcss \"css/*.css\" --base css -d .dist/assets/style -w",
		"dev:js": "rollup -c -w --environment build:development",
		"prebuild": "rimraf .dist",
		"build": "pnpm run /^build:.*/",
		"build:static": "node build/src/static.ts -s static -d .dist --svgoConfig svgo.config.js",
		"build:css": "postcss \"css/*.css\" --base css -d .dist/assets/style",
		"build:js": "rollup -c --environment build:production",
		"postbuild": "prettier --config ../.prettierrc.mjs -w \".dist/**/*.{css,json}\" && brotli-cli compress -g \".dist/**/*.{css,js,mjs,json,svg}\" .dist/favicon.ico -m text",
		"test": "node --experimental-test-coverage --test \"javascript/src/**/*.test.ts\""
	},
	"dependencies": {
		"@w0s/base.css": "=1.7.0",
		"@w0s/button-checkboxes": "=4.0.1",
		"@w0s/button-clipboard": "=4.1.0",
		"@w0s/button-confirm": "=3.0.5",
		"@w0s/button-media-same-play": "=3.0.8",
		"@w0s/closest-html-page": "=5.0.4",
		"@w0s/details-animation": "=7.0.8",
		"@w0s/footnote-reference-popover": "=7.4.4",
		"@w0s/form-control-validation": "=6.0.1",
		"@w0s/form-submit-overlay": "=4.0.8",
		"@w0s/input-date-to-text": "=4.0.8",
		"@w0s/input-switch": "=7.0.0",
		"@w0s/report-js-error": "=4.0.4",
		"@w0s/report-same-referrer": "=5.0.3",
		"@w0s/string-convert": "=4.0.2",
		"@w0s/table-cell-ditto": "=4.2.2"
	},
	"devDependencies": {
		"@rollup/plugin-commonjs": "=29.0.3",
		"@rollup/plugin-node-resolve": "=16.0.3",
		"@rollup/plugin-sucrase": "=5.1.0",
		"@types/jsdom": "=30.0.0",
		"@types/trusted-types": "=2.0.7",
		"chokidar": "=6.0.0",
		"jsdom": "=31.0.1",
		"postcss-cli": "=12.0.0",
		"postcss-custom-media": "=12.0.3",
		"postcss-discard-comments": "=9.0.8",
		"postcss-discard-empty": "=9.0.8",
		"postcss-import": "=17.0.1",
		"postcss-nesting": "=14.0.3",
		"rollup": "=4.68.0",
		"rollup-plugin-prettier": "=4.2.0",
		"slash": "=5.1.0",
		"svgo": "=4.1.0",
		"tslib": "=2.9.1"
	},
	"packageManager": "pnpm@12.16.1"
}
